# Application
APP_NAME=Safety Driver AI Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Image upload limits
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/bmp

# Model paths (relative to project root or absolute)
YOLO_MODEL_PATH=models/yolov8n.pt
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task

# Drowsiness (EAR)
EAR_THRESHOLD=0.21
DROWSINESS_CONSECUTIVE_FRAMES=15
DROWSINESS_MIN_DURATION_SECONDS=1.5

# Yawning (MAR)
MAR_THRESHOLD=0.55
YAWNING_CONSECUTIVE_FRAMES=12
YAWNING_MIN_DURATION_SECONDS=1.2

# Phone usage
PHONE_DETECTION_CONFIDENCE=0.45
PHONE_USAGE_IOU_THRESHOLD=0.05
PHONE_USAGE_MAX_DISTANCE_RATIO=0.45
PHONE_USAGE_CONSECUTIVE_FRAMES=8

# Head pose / distraction (degrees)
HEAD_YAW_THRESHOLD_DEGREES=25.0
HEAD_PITCH_THRESHOLD_DEGREES=20.0
DISTRACTION_CONSECUTIVE_FRAMES=12
DISTRACTION_MIN_DURATION_SECONDS=1.5

# Abnormal movement
MOVEMENT_VELOCITY_THRESHOLD=0.08
ABNORMAL_MOVEMENT_CONSECUTIVE_FRAMES=10

# Session / temporal tracking
DEFAULT_FPS=10.0
SESSION_TTL_SECONDS=300
